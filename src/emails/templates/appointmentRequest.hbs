<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>New Appointment Request</title>
  </head>
  <body style="font-family: Arial, sans-serif; color: #111;">
    <h2>New appointment request</h2>
    <p>Hello {{ownerFirstName}},</p>
    <p>{{renterName}} requested a property visit appointment.</p>
    <ul>
      <li><strong>Property:</strong> {{propertyTitle}}</li>
      <li><strong>Address:</strong> {{propertyAddress}}</li>
      <li><strong>Starts:</strong> {{startsAt}}</li>
      <li><strong>Ends:</strong> {{endsAt}}</li>
    </ul>
    <p>Please review and confirm in your dashboard.</p>
  </body>
</html>
