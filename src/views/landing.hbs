    <script>
        (function () {
            const badge = document.getElementById('system-status-badge');
            if (!badge) return;

            const setBadge = (state, label) => {
                badge.classList.remove('badge--online', 'badge--offline', 'badge--checking');
                badge.classList.add(`badge--${state}`);
                badge.innerHTML = `<span class="ping"></span> ${label}`;
            };

            const checkHealth = async () => {
                setBadge('checking', 'Checking System Status...');

                try {
                    const response = await fetch('/health', { cache: 'no-store' });
                    if (!response.ok) {
                        throw new Error(`Health check failed with status ${response.status}`);
                    }

                    const data = await response.json();
                    const isHealthy = data && data.status === 'ok';
                    setBadge(isHealthy ? 'online' : 'offline', isHealthy ? 'System Online' : 'System Degraded');
                } catch (_) {
                    setBadge('offline', 'System Offline');
                }
            };

            checkHealth();
            setInterval(checkHealth, 10000);
        })();
    </script>
