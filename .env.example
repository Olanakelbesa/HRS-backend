PORT=5000

# Optional. If omitted, it is derived dynamically:
# development/test -> http://localhost:${PORT}
# production       -> https://localhost:${PORT}
# Example for Render: https://smarthouserental.onrender.com
APP_BASE_URL=

# Local (no Docker): use localhost. Create DB: psql -U postgres -c "CREATE DATABASE house_rental;"
# Docker: same URL; start with docker compose up -d postgres redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/house_rental
REDIS_URL=redis://localhost:6379

# SMTP (production-safe defaults for Gmail App Password setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Leave empty to auto-derive from SMTP_PORT (465 => true, others => false)
SMTP_SECURE=
# Alternative port retry used by backend if the primary fails
SMTP_FALLBACK_PORT=587
# Optional custom sender value. Example: House Rental <no-reply@yourdomain.com>
EMAIL_FROM=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-token-secret-must-be-different-and-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:3000

# Optional but required for email features (verification, forgot password)
GOOGLE_EMAIL_USER=your-gmail-address@gmail.com
GOOGLE_EMAIL_PASS=your-gmail-app-password

NODE_ENV=development

