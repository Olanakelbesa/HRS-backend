// Prisma schema for Smart House Rental Platform
// Add your ER diagram models here

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RENTER
  OWNER
  ADMIN
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  RENTED
  UNAVAILABLE
}

enum PropertyType {
  VILLA
  APARTMENT
  CONDO
  STUDIO
  HOUSE
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String
  name       String?
  role       UserRole   @default(RENTER)
  properties Property[]
  reviews Review[]

  // Security fields
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  refreshTokens RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Property {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  type   PropertyType
  status PropertyStatus @default(AVAILABLE)

  title       Json
  description Json
  location    String
  address     String?
  reviews Review[]

  price     Float
  bedrooms  Int?
  bathrooms Int?
  area      Float?

  amenities      Json
  furnishingType String?

  images String[] @default([])
  videos String[] @default([])

  rentTerms Json?

  viewsCount Int @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([price])
  @@index([status])
  @@index([type])
}

model Review {
  id         String   @id @default(cuid())

  rating     Int      // 1–5
  comment    String?

  userId     String
  propertyId String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, propertyId]) 
  @@index([userId])
}