generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                 @id @default(cuid())
  email               String?                @unique
  password            String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  emailVerified       Boolean                @default(false)
  image               String?
  isVerified          Boolean                @default(false)
  phone               String?                @unique
  preferredLanguage   String?
  role                Role                   @default(renter)
  first_name          String?
  last_name           String?
  status              UserStatus             @default(active)
  verificationState   VerificationState      @default(pending_otp)
  accounts            Account[]
  ownerAgreements     Agreement[]            @relation("OwnerAgreements")
  renterAgreements    Agreement[]            @relation("RenterAgreements")
  ownerAppointments   Appointment[]          @relation("OwnerAppointments")
  renterAppointments  Appointment[]          @relation("RenterAppointments")
  auditLogs           AuditLog[]
  ownerConversations  Conversation[]         @relation("OwnerConversations")
  renterConversations Conversation[]         @relation("RenterConversations")
  messagesSent        Message[]              @relation("UserMessages")
  messageReactions    MessageReaction[]
  notifications       Notification[]
  properties          Property[]             @relation("OwnerProperties")
  refreshTokens       RefreshToken[]
  reportsSubmitted    Report[]               @relation("SubmittedReports")
  reviews             Review[]
  sessions            Session[]
  reviewedDocs        VerificationDocument[] @relation("ReviewedDocuments")
  verificationDocs    VerificationDocument[] @relation("VerificationDocuments")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Conversation {
  id         String    @id @default(cuid())
  propertyId String?
  renterId   String
  ownerId    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  owner      User      @relation("OwnerConversations", fields: [ownerId], references: [id])
  property   Property? @relation(fields: [propertyId], references: [id])
  renter     User      @relation("RenterConversations", fields: [renterId], references: [id])
  messages   Message[]

  @@index([renterId])
  @@index([ownerId])
  @@index([propertyId])
}

model Property {
  id             String         @id @default(cuid())
  title          Json
  description    Json
  location       String
  address        String?
  price          Float
  bedrooms       Int?
  bathrooms      Int?
  area           Float?
  furnishingType String?
  images         String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean        @default(false)
  ownerId        String
  rentTerms      Json?
  status         PropertyStatus @default(AVAILABLE)
  videos         String[]       @default([])
  viewsCount     Int            @default(0)
  type           PropertyType
  amenities      Json
  agreements     Agreement[]
  appointments   Appointment[]
  conversations  Conversation[]
  owner          User           @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
  @@index([isDeleted])
  @@index([price])
  @@index([type])
}

model Appointment {
  id         String            @id @default(cuid())
  propertyId String
  renterId   String
  ownerId    String
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(PENDING)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  owner      User              @relation("OwnerAppointments", fields: [ownerId], references: [id], onDelete: Cascade)
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renter     User              @relation("RenterAppointments", fields: [renterId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([renterId])
  @@index([ownerId])
  @@index([startsAt])
  @@index([status])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  status         MessageStatus       @default(SENT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  replyToId      String?
  type           MessageType         @default(TEXT)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?            @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]           @relation("MessageReplies")
  sender         User                @relation("UserMessages", fields: [senderId], references: [id])
  attachments    MessageAttachment[]
  reactions      MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  fileName  String
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  eventType  String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([eventType])
  @@index([entityType])
  @@index([createdAt])
}

model Agreement {
  id            String          @id @default(cuid())
  propertyId    String
  renterId      String
  ownerId       String
  monthlyRent   Float
  currency      String          @default("ETB")
  startDate     DateTime
  endDate       DateTime
  status        AgreementStatus @default(draft)
  paymentStatus PaymentStatus   @default(pending)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  owner         User            @relation("OwnerAgreements", fields: [ownerId], references: [id])
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renter        User            @relation("RenterAgreements", fields: [renterId], references: [id])

  @@index([propertyId])
  @@index([renterId])
  @@index([ownerId])
}

model Report {
  id           String           @id @default(cuid())
  reportedById String
  targetId     String
  targetType   ReportTargetType
  category     String
  description  String
  status       ReportStatus     @default(open)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reportedBy   User             @relation("SubmittedReports", fields: [reportedById], references: [id])

  @@index([reportedById])
  @@index([targetId])
}

model VerificationDocument {
  id           String                   @id @default(cuid())
  userId       String
  documentType VerificationDocumentType
  documentUrl  String
  status       VerificationStatus       @default(pending)
  submittedAt  DateTime                 @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                    @relation("ReviewedDocuments", fields: [reviewedById], references: [id])
  user         User                     @relation("VerificationDocuments", fields: [userId], references: [id])

  @@index([userId])
}

model Review {
  id         String           @id @default(cuid())
  reviewerId String
  targetType ReviewTargetType
  targetId   String
  rating     Int
  comment    String
  status     ReviewStatus     @default(published)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reviewer   User             @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([targetId, targetType])
}

enum Role {
  renter
  owner
  admin
}

enum UserStatus {
  active
  suspended
  banned
}

enum VerificationState {
  verified
  pending_otp
  pending_documents
  rejected
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  RENTED
  UNAVAILABLE
}

enum PropertyType {
  VILLA
  APARTMENT
  CONDO
  STUDIO
  HOUSE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  MESSAGE_NEW
  APPOINTMENT_BOOKED
  APPOINTMENT_UPDATED
}

enum AgreementStatus {
  active
  pending_renter
  pending_owner
  draft
  terminated
  expired
}

enum ReportTargetType {
  property
  user
  agreement
  other
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum ReviewTargetType {
  property
  owner
}

enum ReviewStatus {
  published
  flagged
  removed
}

enum PaymentStatus {
  confirmed
  proof_uploaded
  pending
}

enum VerificationDocumentType {
  national_id
  passport
  ownership_deed
}
